ALLSEL

ESEL,S,COMP,,WELD_PASS_1_CM
ESEL,A,COMP,,WELD_PASS_2_CM
ESEL,A,COMP,,WELD_PASS_3_CM
EKILL,ALL
ALLSEL


A=0.003
B=0.004
C1=0.004
C2=0.016
TAU=0
FF=0.6
FR=1.4
Q=2000
VEL=0.001


time_inc=1
pass_dur=100
time_steps=300  
pass_offset=0

NROPT,FULL
AUTOTS,ON


*DO,i,1,time_steps,1
WTIME=(i*time_inc)
TIME,WTIME
    
*IF,WTIME,LE,pass_dur,THEN
CURR_PASS_CM='WELD_PASS_1_CM'
pass_offset=0
*ELSEIF,WTIME,LE,(pass_dur*2),THEN
CURR_PASS_CM='WELD_PASS_2_CM'
pass_offset=pass_dur
*ELSE
CURR_PASS_CM='WELD_PASS_3_CM'
pass_offset=(pass_dur*2)
*ENDIF
    

CMSEL,S,%CURR_PASS_CM%
EALIVE,ALL
    

*GET,EMIN,ELEM,,NUM,MIN
*GET,EMAX,ELEM,,NUM,MAX

HCENTER = VEL*(WTIME-pass_offset)


*DO,jj,EMIN,EMAX,1
*IF,ELNEXT(jj),NE,0,THEN 
X=CENTRX(jj)
Y=CENTRY(jj)
Z=CENTRZ(jj)
            

CSI=-Z+(VEL*(TAU-(WTIME-pass_offset)))

*IF,Z,GT,HCENTER,THEN
C_VAL=C1
F_VAL=FF
*ELSE
C_VAL=C2
F_VAL=FR
*ENDIF
            
PART1=(6*(3**0.5)*Q*F_VAL)/(A*B*C_VAL*3.14159*(3.14159**0.5))
PART2=(exp(-3*(X/A)**2))*(exp(-3*(Y/B)**2))*(exp(-3*(CSI/C_VAL)**2))
QF=PART1*PART2
            
BFE,jj,HGEN,,QF
*ENDIF
*ENDDO
    
ALLSEL
SOLVE
BFEDELE,ALL,ALL 
